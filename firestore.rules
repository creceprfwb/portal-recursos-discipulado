rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /prayerRequests/{requestId} {
      allow read: if resource.data.approved == true && resource.data.privacy == "public";
      allow read: if request.auth != null;

      allow create: if request.resource.data.keys().hasOnly([
          "name",
          "anonymous",
          "title",
          "description",
          "category",
          "status",
          "urgent",
          "privacy",
          "allowEncouragement",
          "prayerCount",
          "approved",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.status == "pending"
        && request.resource.data.approved == false
        && request.resource.data.prayerCount == 0
        && request.resource.data.privacy in ["public", "pastoral"];

      allow update: if request.auth != null;
      allow update: if resource.data.approved == true
        && resource.data.privacy == "public"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["prayerCount", "updatedAt"])
        && request.resource.data.prayerCount == resource.data.prayerCount + 1;

      allow delete: if request.auth != null;
    }

    match /prayerContacts/{contactId} {
      allow create: if request.resource.data.keys().hasOnly([
          "requestId",
          "email",
          "phone",
          "notificationPreference",
          "createdAt"
        ]);
      allow read, update, delete: if request.auth != null;
    }

    match /forumPosts/{postId} {
      allow read: if resource.data.status == "approved";
      allow read: if request.auth != null;

      allow create: if request.resource.data.keys().hasOnly([
          "name",
          "message",
          "parentId",
          "resourceId",
          "resourceTitle",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.resourceId is string
        && request.resource.data.status == "pending";

      allow update, delete: if request.auth != null;
    }

    match /forumContacts/{postId} {
      allow create: if request.resource.data.keys().hasOnly([
          "postId",
          "email",
          "createdAt"
        ]);
      allow read, update, delete: if request.auth != null;
    }

    match /subscribers/{subscriberId} {
      allow create: if request.resource.data.keys().hasOnly([
          "name",
          "email",
          "phone",
          "church",
          "purpose",
          "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.church is string
        && request.resource.data.church.size() > 0;
      allow read, update, delete: if request.auth != null;
    }

    match /resourceDownloads/{downloadId} {
      allow create: if request.resource.data.keys().hasOnly([
          "subscriberId",
          "resourceId",
          "resourceTitle",
          "createdAt"
        ])
        && request.resource.data.subscriberId is string
        && request.resource.data.resourceId is string;
      allow read, update, delete: if request.auth != null;
    }

    match /eventRegistrations/{registrationId} {
      allow create: if request.resource.data.keys().hasOnly([
          "eventId",
          "eventTitle",
          "name",
          "email",
          "phone",
          "church",
          "attendees",
          "attendeeNames",
          "role",
          "notes",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.eventId is string
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.attendeeNames is list
        && request.resource.data.status == "new";
      allow read, update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
