rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /prayerRequests/{requestId} {
      allow read: if resource.data.approved == true && resource.data.privacy == "public";
      allow read: if request.auth != null;

      allow create: if request.resource.data.keys().hasOnly([
          "name",
          "anonymous",
          "title",
          "description",
          "category",
          "status",
          "urgent",
          "privacy",
          "allowEncouragement",
          "prayerCount",
          "approved",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.status == "pending"
        && request.resource.data.approved == false
        && request.resource.data.prayerCount == 0
        && request.resource.data.privacy in ["public", "pastoral"];

      allow update: if request.auth != null;
      allow update: if resource.data.approved == true
        && resource.data.privacy == "public"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["prayerCount", "updatedAt"])
        && request.resource.data.prayerCount == resource.data.prayerCount + 1;

      allow delete: if request.auth != null;
    }

    match /prayerContacts/{contactId} {
      allow create: if request.resource.data.keys().hasOnly([
          "requestId",
          "email",
          "phone",
          "notificationPreference",
          "createdAt"
        ]);
      allow read, update, delete: if request.auth != null;
    }

    match /forumPosts/{postId} {
      allow read: if resource.data.status == "approved";
      allow read: if request.auth != null;

      allow create: if request.resource.data.keys().hasOnly([
          "name",
          "message",
          "parentId",
          "resourceId",
          "resourceTitle",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.resourceId is string
        && request.resource.data.status == "pending";

      allow update, delete: if request.auth != null;
    }

    match /forumContacts/{postId} {
      allow create: if request.resource.data.keys().hasOnly([
          "postId",
          "email",
          "createdAt"
        ]);
      allow read, update, delete: if request.auth != null;
    }

    match /subscribers/{subscriberId} {
      allow create: if request.resource.data.keys().hasOnly([
          "name",
          "email",
          "phone",
          "church",
          "purpose",
          "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.church is string
        && request.resource.data.church.size() > 0;
      allow read, update, delete: if request.auth != null;
    }

    match /resourceDownloads/{downloadId} {
      allow create: if request.resource.data.keys().hasOnly([
          "subscriberId",
          "resourceId",
          "resourceTitle",
          "createdAt"
        ])
        && request.resource.data.subscriberId is string
        && request.resource.data.resourceId is string;
      allow read, update, delete: if request.auth != null;
    }

    match /eventRegistrations/{registrationId} {
      allow create: if request.resource.data.keys().hasOnly([
          "eventId",
          "eventTitle",
          "name",
          "email",
          "phone",
          "church",
          "attendees",
          "attendeeNames",
          "role",
          "notes",
          "status",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.eventId is string
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.attendeeNames is list
        && request.resource.data.status == "new";
      allow read, update, delete: if request.auth != null;
    }

    match /parkingServers/{serverId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /parkingAssignments/{assignmentId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /calendarEvents/{eventId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ===== Visitas y seguimiento =====
    // Roles en visitStaff/{correo}: bienvenida, responsable, pastor, admin.
    // Solo valen cuentas con el correo confirmado: asi nadie puede hacerse
    // pasar por un miembro del equipo registrando su correo antes que el.
    function visitEmail() {
      return request.auth.token.email;
    }

    function visitVerified() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function visitStaffData() {
      return get(/databases/$(database)/documents/visitStaff/$(visitEmail())).data;
    }

    function isVisitStaff() {
      return visitVerified()
        && exists(/databases/$(database)/documents/visitStaff/$(visitEmail()))
        && visitStaffData().active == true;
    }

    function isVisitManager() {
      return isVisitStaff() && visitStaffData().role in ["admin", "pastor"];
    }

    function isVisitFollowUp() {
      return isVisitStaff() && visitStaffData().role == "responsable";
    }

    function assignedToMe(personId) {
      return get(/databases/$(database)/documents/visitPeople/$(personId)).data.assignedTo == visitEmail();
    }

    function validVisitPerson(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.followUpStatus in ["pendiente", "contactado", "regreso", "discipulado", "pausado"];
    }

    function validVisitStaff(data, staffId) {
      return data.email == staffId
        && staffId == staffId.lower()
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.role in ["bienvenida", "responsable", "pastor", "admin"]
        && data.active is bool;
    }

    function visitChangedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /visitStaff/{staffId} {
      allow get: if request.auth != null && request.auth.token.email == staffId;
      allow read: if isVisitStaff();

      // Primer administrador: solo estos correos, ya confirmados, pueden
      // darse de alta a si mismos.
      allow create: if visitVerified()
        && staffId == visitEmail()
        && staffId in ["jesuseselcentropr@gmail.com"]
        && validVisitStaff(request.resource.data, staffId)
        && request.resource.data.role == "admin";

      allow create: if isVisitManager() && validVisitStaff(request.resource.data, staffId);

      // Nadie cambia su propio rol ni su propio acceso.
      allow update: if isVisitManager()
        && staffId != visitEmail()
        && visitChangedOnly(["name", "role", "active", "updatedAt"])
        && validVisitStaff(request.resource.data, staffId);
      allow delete: if false;
    }

    // Bandeja de entrada del formulario publico: cualquiera puede dejar un
    // registro nuevo, pero solo el equipo los lee. El panel los convierte en
    // fichas y visitas.
    match /visitSubmissions/{submissionId} {
      allow create: if request.resource.data.keys().hasOnly([
          "name", "phone", "email", "preferredContact", "firstVisit", "companions",
          "wantsInfo", "allowContact", "hasPrayerRequest", "status", "createdAt",
          "invitedBy"
        ])
        && request.resource.data.keys().hasAll([
          "name", "phone", "email", "preferredContact", "firstVisit", "companions",
          "wantsInfo", "allowContact", "hasPrayerRequest", "status", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 30
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.preferredContact in ["whatsapp", "llamada", "texto", "correo"]
        && request.resource.data.firstVisit is bool
        && request.resource.data.wantsInfo is bool
        && request.resource.data.allowContact is bool
        && request.resource.data.hasPrayerRequest is bool
        && request.resource.data.companions is list
        && request.resource.data.companions.size() <= 8
        // Opcional: las paginas en cache todavia no lo envian.
        && (!("invitedBy" in request.resource.data)
          || (request.resource.data.invitedBy is string
            && request.resource.data.invitedBy.size() <= 80))
        && request.resource.data.status == "nueva"
        && request.resource.data.createdAt == request.time;

      allow read: if isVisitStaff();
      allow update: if isVisitStaff()
        && resource.data.status == "nueva"
        && request.resource.data.status in ["procesada", "descartada"]
        && visitChangedOnly(["status", "personId", "processedAt", "processedBy"]);
      allow delete: if false;

      // La peticion de oracion se guarda aparte para que solo la lean el
      // pastor y el administrador.
      match /private/{docId} {
        allow create: if docId == "prayer"
          && request.resource.data.keys().hasOnly(["text", "createdAt"])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow read: if isVisitManager();
        allow update, delete: if false;
      }
    }

    match /visitPeople/{personId} {
      allow read: if isVisitStaff();

      allow create: if isVisitStaff()
        && validVisitPerson(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.mergedInto == null
        && (request.resource.data.assignedTo == null || isVisitManager());

      // Administrador o pastor: gestion completa.
      allow update: if isVisitManager() && validVisitPerson(request.resource.data);

      // Todo el equipo: datos de contacto y contadores al registrar una visita.
      allow update: if isVisitStaff()
        && validVisitPerson(request.resource.data)
        && visitChangedOnly([
          "name", "nameKey", "phone", "phoneKey", "email", "emailKey",
          "preferredContact", "invitedBy", "consent", "familyId", "familyRelation",
          "hasPrayerRequest", "prayerSubmissionIds", "firstVisitAt", "lastVisitAt",
          "visitCount", "followUpStatus", "updatedAt"
        ])
        && (request.resource.data.followUpStatus == resource.data.followUpStatus
          || request.resource.data.followUpStatus == "regreso");

      // Responsable: trabaja el seguimiento de las personas que tiene asignadas.
      allow update: if isVisitFollowUp()
        && resource.data.assignedTo == visitEmail()
        && validVisitPerson(request.resource.data)
        && visitChangedOnly([
          "name", "nameKey", "phone", "phoneKey", "email", "emailKey",
          "preferredContact", "invitedBy", "consent", "hasPrayerRequest", "prayerSubmissionIds",
          "firstVisitAt", "lastVisitAt", "visitCount",
          "followUpStatus", "nextAction", "nextActionDate", "lastContactAt", "updatedAt"
        ]);

      // Responsable: puede tomar un seguimiento que nadie tiene asignado.
      allow update: if isVisitFollowUp()
        && resource.data.assignedTo == null
        && request.resource.data.assignedTo == visitEmail()
        && visitChangedOnly(["assignedTo", "assignedToName", "updatedAt"]);

      allow delete: if false;

      // Historial de contactos y notas de seguimiento.
      match /contacts/{contactId} {
        allow read: if isVisitManager() || (isVisitFollowUp() && assignedToMe(personId));
        allow create: if (isVisitManager() || (isVisitFollowUp() && assignedToMe(personId)))
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 2000;
        allow update, delete: if isVisitManager();
      }

      // Notas pastorales y peticiones de oracion: solo admin y pastor las
      // leen. El resto del equipo puede escribirlas y ver solo las propias.
      match /pastoral/{noteId} {
        allow read: if isVisitManager()
          || (isVisitStaff() && resource.data.byUid == request.auth.uid);
        allow create: if isVisitStaff()
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.type in ["nota", "peticion"]
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if isVisitManager();
      }
    }

    match /visitRecords/{recordId} {
      allow read: if isVisitStaff();
      allow create: if isVisitStaff()
        && request.resource.data.personId is string
        && request.resource.data.registeredBy == request.auth.uid
        && request.resource.data.visitedAt is timestamp;
      allow update, delete: if isVisitManager();
    }

    match /visitFamilies/{familyId} {
      allow read: if isVisitStaff();
      allow create, update: if isVisitStaff()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 160;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
